# Generated and machine-local project state
/Artifacts/
/Local/
/Apps/
/Support/

/BuildSpace/*
!/BuildSpace/.gitkeep
/Published/*
!/Published/.gitkeep
/Temp/*
!/Temp/.gitkeep
/Development/
/Secrets/
/[Pp]references.yaml

# Recipe/runtime content intentionally maintained outside Git
/Icons/*
!/Icons/.gitkeep
/Scripts/*
!/Scripts/.gitkeep
/Tools/*
!/Tools/.gitkeep

# Sensitive or site-specific recipe data
/.env
/.env.*
!/.env.example
*.pfx
*.p12
*.key
/Recipes/*.common.yaml
/Recipes/crowdstrikefalcon.yaml
/Recipes/Incomplete/
/Recipes/Disabled/*
/Docs/ServiceNow*

# Active recipe development is local until explicitly promoted
/Recipes/Development/*

# Development-only module variants and generated output
/Modules/YardstickSupportDev.psm1
/Yardstick_backup.ps1
*.intunewin
/testResults*.xml
/*.trx
*.log
*.tmp
*.bak
*.swp
/notificationSound.wav
Architecture.md

# Local test and harness output; the Tests source tree itself stays versioned
/TestResults/
/PesterResults/
/coverage/
/.coverage/
/.cache/
*.coverage
*.coveragexml
*.clixml
/Tests/**/artifacts/
/Tests/**/downloads/
/Tests/**/logs/
/Tests/**/temp/
/Tests/**/tmp/

# Versioned development-only source remains in Git. Production exclusion for
# .github, Docs, Tests, README.md, and Publish-Yardstick.ps1 (and Config, apart
# from Preferences.example.yaml, which the installer needs) is enforced
# by the explicit allowlist in Publish-Yardstick.ps1, not by this file.


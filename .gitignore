# Generated and machine-local project state
/Artifacts/
/Local/
/Apps/
/Support/

# Retired pre-consolidation locations; ignore them if an older script recreates them
/BuildSpace/
/Published/
/Temp/
/Development/
/Secrets/
/[Pp]references.yaml

# Recipe/runtime content intentionally maintained outside Git
/Icons/*
!/Icons/.gitkeep
/Scripts/*
!/Scripts/.gitkeep
!/Scripts/AdobeDownloader.psm1
!/Scripts/YardstickSupport.psm1
/Tools/*
!/Tools/.gitkeep

# Sensitive or site-specific recipe data
/.env
/.env.*
!/.env.example
*.pfx
*.p12
*.key
/Recipes/*.common.yaml
/Recipes/crowdstrikefalcon.yaml
/Recipes/Incomplete/
/Recipes/Disabled/*

# Active recipe development is local until explicitly promoted
/Recipes/Development/*

# Development-only module variants and generated output
/Modules/YardstickSupportDev.psm1
/Yardstick_backup.ps1
*.intunewin
/testResults*.xml
/*.trx
*.log
*.tmp
*.bak
*.swp
/notificationSound.wav
Architecture.md

# Local test and harness output; the Tests source tree itself stays versioned
/TestResults/
/PesterResults/
/coverage/
/.coverage/
/.cache/
*.coverage
*.coveragexml
*.clixml
/Tests/**/artifacts/
/Tests/**/downloads/
/Tests/**/logs/
/Tests/**/temp/
/Tests/**/tmp/

# Versioned development-only source remains in Git. Production exclusion for
# .github, Config, Docs, Tests, README.md, and Publish-Yardstick.ps1 is enforced
# by the explicit allowlist in Publish-Yardstick.ps1, not by this file.

# Editors, dependencies, and local Codex scratch state
/.vscode/
/.idea/
/.vs/
/.DS_Store
/Thumbs.db
/Desktop.ini
/node_modules/
/.pnpm-store/
/.codex-triage/
/.codex-inspect-*
/.codex/*
!/.codex/skills/
!/.codex/skills/**
